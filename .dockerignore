# Дозволяю передавати в Docker build тільки явно перелічені нижче файли
# Локальні бази, .env, історія Git, TLS-ключі, kubeconfig і знімки не мають потрапити в контекст збірки
# ** спочатку виключає все, а ! повертає потрібні файли, остаточні правила знову виключають секретні формати
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.ts
!src/
!src/**
!migrations/
!migrations/*.sql
!examples/
!examples/*.json
!scripts/
!scripts/clean.mjs
!scripts/copy-migrations.mjs
!scripts/copy-route-examples.mjs
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.cookies
**/cookies*.txt
