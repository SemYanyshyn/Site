# Для локального Postgres.app рекомендовано npm run db:setup — він створить .env.
# Ці значення є placeholders для власного підключення, а не робочими секретами.
PORT=3000
DATABASE_URL=postgresql://courier_route:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/courier_route
TEST_DATABASE_URL=postgresql://courier_route:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/courier_route_test
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
