# 127.0.0.1 для локального запуску; Docker використовує 0.0.0.0.
HOST=127.0.0.1
# Для локального Postgres.app рекомендовано npm run db:setup — він створить .env.
# Ці значення є placeholders для власного підключення, а не робочими секретами.
PORT=3000
DATABASE_URL=postgresql://courier_route:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/courier_route
TEST_DATABASE_URL=postgresql://courier_route:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/courier_route_test
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
# Початкові проєктні ліміти маршруту; вони не є числами з умови викладача.
ROUTE_MAX_POINTS=500
ROUTE_MAX_ITERATIONS=50000000
ROUTE_TIMEOUT_MS=30000
# Однакові значення для всіх HTTP-процесів зі спільною БД.
JOBS_MAX_ACTIVE_PER_USER=3
JOBS_MAX_OUTSTANDING=100
JOBS_POLL_INTERVAL_MS=250
# Мінімальний запас; фактичний також покриває polling і bounded DB-операції.
JOBS_WORKER_LOST_GRACE_MS=5000
# Один реальний worker-слот на процес; PG задає час реєстрації/свіжості.
EXECUTOR_HEARTBEAT_INTERVAL_MS=1000
# До 60000 мс, але не менше 3 × heartbeat interval + 6000 мс.
EXECUTOR_LEASE_TTL_MS=15000
