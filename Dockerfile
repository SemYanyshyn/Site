# Мої нотатки: цей файл — рецепт, за яким Docker готує середовище для запуску застосунку.
# Образ — це готова заготовка з файлами й програмами; контейнер — запущений екземпляр такого образу.
# Рядки з # — мої пояснення, Docker їх не виконує.
# Тут розділяю підготовку на етапи: спільна основа, збирання, робочі залежності та фінальний образ.
# Усі шляхи /app нижче стосуються образу або контейнера, а не папки /app на моєму MacBook.

# Беру готовий офіційний образ: у ньому вже є Node.js 24.18.0 і npm 11.16.0.
# bookworm — це версія Linux Debian усередині образу, slim — його зменшений варіант.
# Частиною після @sha256: закріплюю точний образ, щоб не отримати інший під тим самим тегом.
# Називаю цей спільний початковий етап base, щоб далі посилатися на нього.
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS base

# Обираю /app робочою папкою всередині образу. Якщо її немає, Docker її створить.
# Подальші відносні шляхи, наприклад ./src, відраховуються від цієї папки.
WORKDIR /app

# Ще під час збирання перевіряю, що всередині справді потрібні версії Node.js і npm.
# RUN виконує команду під час створення образу; це ще не запуск мого сервера.
# $(...) підставляє результат команди, test порівнює значення, а && означає: друга перевірка — після успішної першої.
# Якщо якась версія не збігається, збирання завершиться помилкою.
RUN test "$(node --version)" = "v24.18.0" && test "$(npm --version)" = "11.16.0"

# Починаю окремий етап build, використовуючи вже підготовлений base.
# На цьому етапі збиратиму TypeScript, клієнтські файли й інші матеріали застосунку.
FROM base AS build

# Копіюю з папки проєкту package.json і package-lock.json у поточну /app всередині образу.
# У першому файлі описані залежності й команди npm, у другому закріплені версії залежностей.
# Спочатку беру лише ці файли, щоб Docker міг повторно використати встановлені пакети, коли змінюється тільки код.
COPY package.json package-lock.json ./

# Встановлюю залежності за package-lock.json, включно з інструментами збирання.
# Використовую npm ci для відтворюваного встановлення за lock-файлом.
# --no-audit пропускає додатковий аудит вразливостей під час цієї команди.
# --no-fund прибирає повідомлення про фінансову підтримку авторів пакетів.
RUN npm ci --no-audit --no-fund

# Копіюю налаштування TypeScript і Vite у /app.
# Зірочка в tsconfig*.json означає всі відповідні файли, наприклад tsconfig.server.json і tsconfig.client.json.
COPY tsconfig*.json vite.config.ts ./

# Копіюю папку src з кодом сервера, клієнта й спільних частин у /app/src всередині образу.
COPY src ./src

# Копіюю SQL-файли міграцій у /app/migrations, щоб додати їх до готової збірки.
# Саме копіювання ще не змінює базу даних і не застосовує міграції.
COPY migrations ./migrations

# Копіюю приклади вхідних даних із examples у /app/examples, щоб вони були доступні під час збирання.
COPY examples ./examples

# Копіюю три допоміжні скрипти у /app/scripts.
# Вони очищують каталог збірки та додають до нього міграції й приклади маршруту.
# Тут перераховую потрібні файли явно.
COPY scripts/clean.mjs scripts/copy-migrations.mjs scripts/copy-route-examples.mjs ./scripts/

# Запускаю команду build із package.json усередині етапу build.
# Вона перетворює TypeScript на JavaScript, збирає клієнт і SCSS у готовий CSS та копіює потрібні файли.
# Готовий результат отримую в /app/dist.
RUN npm run build

# Починаю ще один окремий етап — production-dependencies — з того самого base.
# Тут підготую тільки пакети, потрібні вже запущеному застосунку.
FROM base AS production-dependencies

# Знову копіюю package.json і package-lock.json у /app цього нового етапу.
# Файли з попереднього етапу build сюди автоматично не переходять: обидва етапи починаються від base.
COPY package.json package-lock.json ./

# Встановлюю пакети для роботи готового застосунку, пропускаючи devDependencies через --omit=dev.
# Інструменти на кшталт TypeScript, Vite й Sass були потрібні для збирання, а готові файли вже створені.
# --no-audit і --no-fund мають те саме значення, що й у попередній команді встановлення.
RUN npm ci --omit=dev --no-audit --no-fund

# Починаю фінальний етап runtime з чистого base.
# Саме з цього останнього етапу отримаю образ для запуску контейнера застосунку.
# Далі заберу з попередніх етапів тільки готові файли та потрібні пакети.
FROM base AS runtime

# Задаю змінні середовища для застосунку всередині контейнера.
# NODE_ENV=production означає режим роботи готового застосунку.
# HOST=0.0.0.0 дозволяє серверу приймати запити через мережеві інтерфейси контейнера.
# PORT=3000 задає порт сервера всередині контейнера; це не автоматичне відкриття порту на MacBook.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000

# Беру /app/node_modules з етапу production-dependencies і кладу в /app/node_modules фінального образу.
# --from указує, з якого етапу беру файли, а --chown=node:node призначає їм користувача і групу node.
# Отже, у фінальний образ переходять пакети для роботи застосунку.
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules

# Беру готову папку dist з етапу build і копіюю її у /app/dist фінального образу.
# Тут уже зібрані сервер, клієнт, обчислювальні потоки та інші потрібні файли.
# Власником цих файлів теж призначаю користувача node.
COPY --from=build --chown=node:node /app/dist ./dist

# Копіюю package.json і package-lock.json з етапу build у /app фінального образу.
# Зокрема, package.json зберігає налаштування модулів JavaScript, потрібне для запуску цього проєкту.
# Через --chown=node:node ці файли також належать користувачу і групі node.
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./

# Перемикаю користувача всередині контейнера на node, який уже є в базовому образі.
# Мій сервер працюватиме від нього, а не від адміністративного користувача root.
USER node

# Позначаю, що застосунок усередині контейнера слухає порт 3000.
# EXPOSE — це опис порту: доступ іззовні налаштовується окремо через Docker або Kubernetes.
EXPOSE 3000

# Указую Docker надсилати процесу сигнал SIGTERM під час зупинки контейнера.
# Мій сервер може обробити цей сигнал і коректно завершити роботу та закрити з’єднання.
STOPSIGNAL SIGTERM

# Прибираю успадковану початкову команду ENTRYPOINT базового образу.
# Порожні квадратні дужки означають порожній список; запуск нижче задаю через CMD.
ENTRYPOINT []

# Задаю команду, яку Docker виконає за замовчуванням під час запуску контейнера.
# Запускаю node з готовим серверним файлом /app/dist/server/index.js.
# У квадратних дужках перший елемент — програма, наступний — її аргумент.
# Це прямий запуск без додаткової командної оболонки, тож Node.js безпосередньо отримує сигнали зупинки.
CMD ["node", "/app/dist/server/index.js"]
