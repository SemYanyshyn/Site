{
  "_comment": "Запускаю сервери застосунку й описую внутрішній доступ до них",
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "_comment": "Service дає Traefik сталу адресу для звернення до копій застосунку",
      "metadata": {
        "name": "app",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-app",
          "app.kubernetes.io/component": "app"
        },
        "annotations": {
          "traefik.ingress.kubernetes.io/service.nativelb": "false"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "sessionAffinity": "None",
        "selector": {
          "app.kubernetes.io/name": "courier-route-app"
        },
        "ports": [
          {
            "name": "http",
            "port": 3000,
            "targetPort": "http"
          }
        ],
        "_comment_ports": "port є портом сервісу, targetPort веде до порту контейнера, а nodePort за наявності відкриває порт вузла",
        "_comment_sessions": "Не прив’язую користувача до однієї копії, спільні сесії читаються з PostgreSQL"
      },
      "_comment_purpose": "Об’єдную вибрані через selector pod під сталою мережевою адресою сервісу"
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "_comment": "Описую образ, порти, змінні та ресурси серверів; кількістю копій керує HPA",
      "metadata": {
        "name": "app",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-app",
          "app.kubernetes.io/component": "app"
        }
      },
      "spec": {
        "revisionHistoryLimit": 2,
        "progressDeadlineSeconds": 180,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          }
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "courier-route-app"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "courier-route",
              "app.kubernetes.io/managed-by": "courier-route-local",
              "courier-route.local/owner-id": "__OWNER_ID__",
              "app.kubernetes.io/name": "courier-route-app",
              "app.kubernetes.io/component": "app"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 10,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 1000,
              "fsGroupChangePolicy": "OnRootMismatch",
              "_comment": "Задаю користувача й обмеження для всього pod, це права всередині контейнерного середовища"
            },
            "containers": [
              {
                "name": "app",
                "image": "__APP_IMAGE__",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 3000
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "app-config"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "courier-route-database",
                        "key": "DATABASE_URL"
                      }
                    }
                  },
                  {
                    "name": "POD_UID",
                    "valueFrom": {
                      "fieldRef": {
                        "apiVersion": "v1",
                        "fieldPath": "metadata.uid"
                      }
                    }
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "apiVersion": "v1",
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "POD_NAMESPACE",
                    "valueFrom": {
                      "fieldRef": {
                        "apiVersion": "v1",
                        "fieldPath": "metadata.namespace"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "384Mi"
                  },
                  "_comment": "requests задають запит ресурсів для планування, limits обмежують споживання, 1000m CPU означає одне ядро"
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 5,
                  "failureThreshold": 30,
                  "_comment": "Даю контейнеру час стартувати, доки startup не успішна, звичайні liveness і readiness ще не виконуються"
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3,
                  "_comment": "Перевіряю життєздатність, повторні невдачі можуть спричинити перезапуск контейнера"
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 6,
                  "failureThreshold": 2,
                  "_comment": "Перевіряю готовність обслуговувати запити, неготовий pod вилучається з готових endpoint сервісу"
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "monitor-api",
                    "mountPath": "/var/run/secrets/courier-route",
                    "readOnly": true
                  }
                ],
                "_comment_image": "Вибираю конкретний образ, його значення-шаблон скрипт замінює до застосування маніфесту",
                "_comment_pull": "Не завантажую образ із registry, тому helper спочатку має імпортувати його у вузол kind",
                "_comment_env": "Завантажую несекретні налаштування з ConfigMap, DATABASE_URL отримую окремо через Secret, якщо він указаний у env",
                "_comment_mounts": "Приєдную до контейнера перелічені томи, readOnly забороняє запис через відповідне монтування"
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "monitor-api",
                "projected": {
                  "defaultMode": 288,
                  "sources": [
                    {
                      "serviceAccountToken": {
                        "path": "token",
                        "expirationSeconds": 3600
                      }
                    },
                    {
                      "configMap": {
                        "name": "kube-root-ca.crt",
                        "items": [
                          {
                            "key": "ca.crt",
                            "path": "ca.crt"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ],
            "serviceAccountName": "courier-route-monitor",
            "_comment_runtime": "Описую контейнери одного pod, ресурси, перевірки готовності, доступ до файлів і права запуску",
            "_comment_identity": "POD_UID, POD_NAME та POD_NAMESPACE читаю з Downward API, а credentials до бази — із Secret"
          }
        }
      },
      "_comment_purpose": "Описую бажаний шаблон серверних pod, Kubernetes підтримує їх і виконує оновлення"
    }
  ]
}
