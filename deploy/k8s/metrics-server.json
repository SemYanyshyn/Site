        },
        "annotations": {
          "courier-route.local/manifest-source": "https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.9.0/components.yaml",
          "courier-route.local/manifest-sha256": "1cec29a5267809306a2c6ec74a3e449abbb705b4a8beed0c8a1963910f72c79b"
        },
        "namespace": "courier-route-metrics"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 2,
        "progressDeadlineSeconds": 180,
        "selector": {
          "matchLabels": {
            "k8s-app": "metrics-server"
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "courier-route",
              "app.kubernetes.io/managed-by": "courier-route-local",
              "courier-route.local/owner-id": "__CLUSTER_OWNER_ID__",
              "app.kubernetes.io/name": "courier-route-metrics-server",
              "app.kubernetes.io/component": "metrics",
              "app.kubernetes.io/version": "0.9.0",
              "k8s-app": "metrics-server"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "metrics-server",
                "image": "__METRICS_SERVER_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "--cert-dir=/tmp",
                  "--secure-port=10250",
                  "--kubelet-preferred-address-types=InternalIP,ExternalIP,Hostname",
                  "--kubelet-use-node-status-port",
                  "--metric-resolution=15s",
                  "--kubelet-insecure-tls"
                ],
                "ports": [
                  {
                    "containerPort": 10250,
                    "name": "https",
                    "protocol": "TCP"
                  }
                ],
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/livez",
                    "port": "https",
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/readyz",
                    "port": "https",
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "200Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "300Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "runAsUser": 1000,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "volumeMounts": [
                  {
                    "mountPath": "/tmp",
                    "name": "tmp-dir"
                  }
                ]
              }
            ],
            "nodeSelector": {
              "kubernetes.io/os": "linux"
            },
            "serviceAccountName": "metrics-server",
            "terminationGracePeriodSeconds": 10,
            "volumes": [
              {
                "emptyDir": {
                  "sizeLimit": "32Mi"
                },
                "name": "tmp-dir"
              }
            ]
          }
        }
      }
