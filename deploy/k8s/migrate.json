{
  "_comment": "Описую одноразове завдання Job: виконую міграції PostgreSQL перед запуском оновленого застосунку",
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "__MIGRATION_JOB__",
    "namespace": "__NAMESPACE__",
    "labels": {
      "app.kubernetes.io/part-of": "courier-route",
      "app.kubernetes.io/managed-by": "courier-route-local",
      "courier-route.local/owner-id": "__OWNER_ID__",
      "app.kubernetes.io/name": "courier-route-migrate",
      "app.kubernetes.io/component": "migration"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 120,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-migrate",
          "app.kubernetes.io/component": "migration"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "terminationGracePeriodSeconds": 10,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          },
          "_comment": "Задаю користувача й обмеження для всього pod, це права всередині контейнерного середовища"
        },
        "containers": [
          {
            "name": "migrate",
            "image": "__APP_IMAGE__",
            "imagePullPolicy": "Never",
            "command": [
              "node",
              "/app/dist/server/db/migrate.js"
            ],
            "env": [
              {
                "name": "DATABASE_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "courier-route-database",
                    "key": "DATABASE_URL"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "192Mi"
              },
              "_comment": "requests задають запит ресурсів для планування, limits обмежують споживання, 1000m CPU означає одне ядро"
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ],
            "_comment_image": "Вибираю конкретний образ, його значення-шаблон скрипт замінює до застосування маніфесту",
            "_comment_pull": "Не завантажую образ із registry, тому helper спочатку має імпортувати його у вузол kind",
            "_comment_mounts": "Приєдную до контейнера перелічені томи, readOnly забороняє запис через відповідне монтування"
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "16Mi"
            }
          }
        ],
        "_comment_runtime": "Описую контейнери одного pod, ресурси, перевірки готовності, доступ до файлів і права запуску"
      }
    }
  },
  "_comment_purpose": "Запускаю скінченне службове завдання, тут це міграції, а не користувацька задача маршруту"
}
