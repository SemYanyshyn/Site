{
  "_comment": "Даю серверу застосунку обмежений доступ для читання даних адмінпанелі",
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "courier-route-monitor",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__"
        }
      },
      "automountServiceAccountToken": false,
      "_comment_purpose": "Задаю обліковий запис pod для доступу до API Kubernetes, це не користувач вебзастосунку"
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "_comment": "Дозволяю читати потрібні pod, метрики, Deployment і HPA у своєму просторі імен; не даю права змінювати ресурси або читати Secret",
      "metadata": {
        "name": "courier-route-monitor",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__"
        }
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            "metrics.k8s.io"
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "resourceNames": [
            "app"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            "autoscaling"
          ],
          "resources": [
            "horizontalpodautoscalers"
          ],
          "resourceNames": [
            "app"
          ],
          "verbs": [
            "get"
          ]
        }
      ],
      "_comment_purpose": "Перелічую дозволені дії над ресурсами лише в цьому namespace"
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "courier-route-monitor",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "courier-route-monitor"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "courier-route-monitor",
          "namespace": "__NAMESPACE__"
        }
      ],
      "_comment_purpose": "Пов’язую роль із ServiceAccount у вказаному namespace"
    }
  ]
}
