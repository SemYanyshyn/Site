{
  "_comment": "Запускаю PostgreSQL і описую доступ до бази даних усередині кластера",
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-postgres",
          "app.kubernetes.io/component": "database"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "clusterIP": "None",
        "selector": {
          "app.kubernetes.io/name": "courier-route-postgres"
        },
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": "postgres"
          }
        ],
        "_comment_ports": "port є портом сервісу, targetPort веде до порту контейнера, а nodePort за наявності відкриває порт вузла"
      },
      "_comment_purpose": "Об’єдную вибрані через selector pod під сталою мережевою адресою сервісу"
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "_comment": "Зберігаю дані PostgreSQL в окремому томі PVC; звичайна зупинка не видаляє цей том",
      "metadata": {
        "name": "postgres",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-postgres",
          "app.kubernetes.io/component": "database"
        }
      },
      "spec": {
        "serviceName": "postgres",
        "replicas": 1,
        "revisionHistoryLimit": 2,
        "persistentVolumeClaimRetentionPolicy": {
          "whenDeleted": "Retain",
          "whenScaled": "Retain"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "courier-route-postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "courier-route",
              "app.kubernetes.io/managed-by": "courier-route-local",
              "courier-route.local/owner-id": "__OWNER_ID__",
              "app.kubernetes.io/name": "courier-route-postgres",
              "app.kubernetes.io/component": "database"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 999,
              "runAsGroup": 999,
              "fsGroup": 999,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "_comment": "Задаю користувача й обмеження для всього pod, це права всередині контейнерного середовища"
            },
            "containers": [
              {
                "name": "postgres",
                "image": "__POSTGRES_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "postgres",
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/18/docker"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "postgres"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "postgres"
                  },
                  {
                    "name": "POSTGRES_PASSWORD_FILE",
                    "value": "/run/secrets/postgres/POSTGRES_PASSWORD"
                  },
                  {
                    "name": "POSTGRES_INITDB_ARGS",
                    "value": "--auth-host=scram-sha-256 --auth-local=trust"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  },
                  "_comment": "requests задають запит ресурсів для планування, limits обмежують споживання, 1000m CPU означає одне ядро"
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres",
                      "-d",
                      "postgres"
                    ]
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60,
                  "_comment": "Даю контейнеру час стартувати, доки startup не успішна, звичайні liveness і readiness ще не виконуються"
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres",
                      "-d",
                      "postgres"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6,
                  "_comment": "Перевіряю життєздатність, повторні невдачі можуть спричинити перезапуск контейнера"
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "postgres",
                      "-d",
                      "postgres"
                    ]
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 3,
                  "failureThreshold": 2,
                  "_comment": "Перевіряю готовність обслуговувати запити, неготовий pod вилучається з готових endpoint сервісу"
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql"
                  },
                  {
                    "name": "bootstrap",
                    "mountPath": "/run/secrets/postgres",
                    "readOnly": true
                  },
                  {
                    "name": "run",
                    "mountPath": "/var/run/postgresql"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "shm",
                    "mountPath": "/dev/shm"
                  }
                ],
                "_comment_image": "Вибираю конкретний образ, його значення-шаблон скрипт замінює до застосування маніфесту",
                "_comment_mounts": "Приєдную до контейнера перелічені томи, readOnly забороняє запис через відповідне монтування"
              }
            ],
            "volumes": [
              {
                "name": "bootstrap",
                "secret": {
                  "secretName": "courier-route-postgres",
                  "defaultMode": 288
                }
              },
              {
                "name": "run",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "shm",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "128Mi"
                }
              }
            ],
            "_comment_runtime": "Описую контейнери одного pod, ресурси, перевірки готовності, доступ до файлів і права запуску"
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data",
              "labels": {
                "app.kubernetes.io/part-of": "courier-route",
                "app.kubernetes.io/managed-by": "courier-route-local",
                "courier-route.local/owner-id": "__OWNER_ID__",
                "app.kubernetes.io/name": "courier-route-postgres",
                "app.kubernetes.io/component": "database"
              }
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "2Gi"
                }
              }
            }
          }
        ],
        "_comment_storage": "Створюю PVC для даних PostgreSQL, це збереження поза життєвим циклом окремого pod"
      },
      "_comment_purpose": "Запускаю PostgreSQL зі стабільною ідентичністю та окремим постійним томом"
    }
  ]
}
