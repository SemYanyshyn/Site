{
  "_comment": "Використовую Traefik для приймання HTTPS-запитів і розподілу їх між серверами застосунку",
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "traefik",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-traefik",
          "app.kubernetes.io/component": "ingress"
        }
      },
      "automountServiceAccountToken": true,
      "_comment_purpose": "Задаю обліковий запис pod для доступу до API Kubernetes, це не користувач вебзастосунку"
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "traefik",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-traefik",
          "app.kubernetes.io/component": "ingress"
        }
      },
      "rules": [
        {
          "apiGroups": [""],
          "resources": ["services", "secrets"],
          "verbs": ["get", "list", "watch"]
        },
        {
          "apiGroups": ["discovery.k8s.io"],
          "resources": ["endpointslices"],
          "verbs": ["get", "list", "watch"]
        },
        {
          "apiGroups": ["networking.k8s.io"],
          "resources": ["ingresses"],
          "verbs": ["get", "list", "watch"]
        },
        {
          "apiGroups": ["networking.k8s.io"],
          "resources": ["ingresses/status"],
          "verbs": ["update"]
        }
      ],
      "_comment_purpose": "Перелічую дозволені дії над ресурсами лише в цьому namespace"
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "traefik",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-traefik",
          "app.kubernetes.io/component": "ingress"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "traefik"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "traefik",
          "namespace": "__NAMESPACE__"
        }
      ],
      "_comment_purpose": "Пов’язую роль із ServiceAccount у вказаному namespace"
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "_comment": "Публікую порти HTTP/HTTPS через порти вузла 30080 і 30443",
      "metadata": {
        "name": "traefik",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-traefik",
          "app.kubernetes.io/component": "ingress"
        }
      },
      "spec": {
        "type": "NodePort",
        "sessionAffinity": "None",
        "selector": {
          "app.kubernetes.io/name": "courier-route-traefik"
        },
        "ports": [
          {
            "name": "web",
            "port": 80,
            "targetPort": "web",
            "nodePort": 30080
          },
          {
            "name": "websecure",
            "port": 443,
            "targetPort": "websecure",
            "nodePort": 30443
          }
        ],
        "_comment_ports": "port є портом сервісу, targetPort веде до порту контейнера, а nodePort за наявності відкриває порт вузла",
        "_comment_sessions": "Не прив’язую користувача до однієї копії, спільні сесії читаються з PostgreSQL"
      },
      "_comment_purpose": "Об’єдную вибрані через selector pod під сталою мережевою адресою сервісу"
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "_comment": "Запускаю Traefik, який читає правила Ingress і передає запити потрібному сервісу",
      "metadata": {
        "name": "traefik",
        "namespace": "__NAMESPACE__",
        "labels": {
          "app.kubernetes.io/part-of": "courier-route",
          "app.kubernetes.io/managed-by": "courier-route-local",
          "courier-route.local/owner-id": "__OWNER_ID__",
          "app.kubernetes.io/name": "courier-route-traefik",
          "app.kubernetes.io/component": "ingress"
        }
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 2,
        "progressDeadlineSeconds": 180,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "courier-route-traefik"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "courier-route",
              "app.kubernetes.io/managed-by": "courier-route-local",
              "courier-route.local/owner-id": "__OWNER_ID__",
              "app.kubernetes.io/name": "courier-route-traefik",
              "app.kubernetes.io/component": "ingress"
            }
          },
          "spec": {
            "serviceAccountName": "traefik",
            "automountServiceAccountToken": true,
            "terminationGracePeriodSeconds": 10,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "_comment": "Задаю користувача й обмеження для всього pod, це права всередині контейнерного середовища"
            },
            "containers": [
              {
                "name": "traefik",
                "image": "__TRAEFIK_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "--global.checknewversion=false",
                  "--global.sendanonymoususage=false",
                  "--api=false",
                  "--api.dashboard=false",
                  "--api.insecure=false",
                  "--log.level=WARN",
                  "--accesslog=false",
                  "--providers.kubernetesingress=true",
                  "--providers.kubernetesingress.namespaces=__NAMESPACE__",
                  "--providers.kubernetesingress.ingressclass=courier-route",
                  "--providers.kubernetesingress.disableclusterscoperesources=true",
                  "--providers.kubernetesingress.nativelbbydefault=false",
                  "--providers.kubernetesingress.allowemptyservices=true",
                  "--entrypoints.web.address=:8000",
                  "--entrypoints.web.forwardedheaders.insecure=false",
                  "--entrypoints.web.http.redirections.entrypoint.to=:__HTTPS_PORT__",
                  "--entrypoints.web.http.redirections.entrypoint.scheme=https",
                  "--entrypoints.web.http.redirections.entrypoint.permanent=true",
                  "--entrypoints.websecure.address=:8443",
                  "--entrypoints.websecure.forwardedheaders.insecure=false",
                  "--entrypoints.health.address=:9000",
                  "--ping=true",
                  "--ping.entrypoint=health",
                  "--entrypoints.web.transport.lifecycle.gracetimeout=5s",
                  "--entrypoints.websecure.transport.lifecycle.gracetimeout=5s",
                  "--entrypoints.health.transport.lifecycle.gracetimeout=5s"
                ],
                "ports": [
                  {
                    "name": "web",
                    "containerPort": 8000
                  },
                  {
                    "name": "websecure",
                    "containerPort": 8443
                  },
                  {
                    "name": "health",
                    "containerPort": 9000
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "192Mi"
                  },
                  "_comment": "requests задають запит ресурсів для планування, limits обмежують споживання, 1000m CPU означає одне ядро"
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/ping",
                    "port": "health"
                  },
                  "periodSeconds": 2,
                  "timeoutSeconds": 3,
                  "failureThreshold": 30,
                  "_comment": "Даю контейнеру час стартувати, доки startup не успішна, звичайні liveness і readiness ще не виконуються"
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/ping",
                    "port": "health"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 3,
                  "_comment": "Перевіряю життєздатність, повторні невдачі можуть спричинити перезапуск контейнера"
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ping",
                    "port": "health"
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 3,
                  "failureThreshold": 2,
                  "_comment": "Перевіряю готовність обслуговувати запити, неготовий pod вилучається з готових endpoint сервісу"
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "_comment_image": "Вибираю конкретний образ, його значення-шаблон скрипт замінює до застосування маніфесту",
                "_comment_mounts": "Приєдную до контейнера перелічені томи, readOnly забороняє запис через відповідне монтування"
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              }
            ],
            "_comment_runtime": "Описую контейнери одного pod, ресурси, перевірки готовності, доступ до файлів і права запуску"
          }
        }
      },
      "_comment_purpose": "Описую бажаний шаблон серверних pod, Kubernetes підтримує їх і виконує оновлення"
    }
  ]
}
