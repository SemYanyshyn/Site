{
  "kind": "Cluster",
  "apiVersion": "kind.x-k8s.io/v1alpha4",
  "name": "courier-route",
  "networking": {
    "apiServerAddress": "127.0.0.1"
  },
  "nodes": [
    {
      "role": "control-plane",
      "image": "__KIND_NODE_IMAGE__",
      "labels": {
        "courier-route.local/project": "courier-route"
      },
      "extraPortMappings": [
        {
          "containerPort": 30080,
          "hostPort": "__HTTP_PORT__",
          "listenAddress": "127.0.0.1",
          "protocol": "TCP"
        },
        {
          "containerPort": 30443,
          "hostPort": "__HTTPS_PORT__",
          "listenAddress": "127.0.0.1",
          "protocol": "TCP"
        }
      ]
    }
  ]
}
