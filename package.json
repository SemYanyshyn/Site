{
  "name": "courier-route",
  "version": "0.1.0",
  "private": true,
  "description": "Навчальний планувальник маршруту кур'єра",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx src/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.tests.json",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs && node scripts/copy-route-examples.mjs && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:setup": "node --env-file-if-exists=.env scripts/local-postgres.mjs setup",
    "db:start": "node --env-file-if-exists=.env scripts/local-postgres.mjs start",
    "db:stop": "node --env-file-if-exists=.env scripts/local-postgres.mjs stop",
    "db:status": "node --env-file-if-exists=.env scripts/local-postgres.mjs status",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/db/migrate.ts",
    "db:migrate:built": "node --env-file-if-exists=.env dist/server/db/migrate.js",
    "db:check": "node --env-file-if-exists=.env --import tsx src/server/db/check.ts",
    "test:unit": "node --env-file-if-exists=.env --import tsx --test tests/password.test.ts tests/database-safety.test.ts tests/config.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/auth.integration.test.ts",
    "auth:check": "npm run test:integration",
    "test": "npm run test:unit && npm run test:route && npm run test:integration && npm run test:jobs && npm run test:client && npm run test:queue",
    "route:demo": "node --env-file-if-exists=.env --import tsx src/server/route/cli.ts",
    "route:demo:built": "node --env-file-if-exists=.env dist/server/route/cli.js",
    "route:bench": "node --env-file-if-exists=.env dist/server/route/bench.js",
    "test:route": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/route-algorithm.test.ts tests/route-executor.test.ts tests/route-http.test.ts",
    "test:jobs": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/jobs-config.test.ts tests/jobs.integration.test.ts",
    "test:client": "node --import tsx --test tests/client-input.test.ts tests/client-api.test.ts tests/client-response.test.ts tests/client-geometry.test.ts tests/client-controller.test.ts tests/client-queue.test.ts",
    "test:browser": "node --env-file-if-exists=.env --import tsx scripts/check-client-browser.mjs",
    "test:queue": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/queue-config.test.ts tests/queue-estimator.test.ts tests/queue-read.test.ts tests/queue.integration.test.ts"
  },
  "dependencies": {
    "cookie": "2.0.1",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
